{
  "imports": [
    "../../qml",
    "../../qml/imports",
    "../../qml/content",
    "../../qml/content/Settings"
  ],
  "interfaces": [
    {
      "type": "Serial",
      "default": {
        "port": "COM1",
        "baud": 9600,
        "size": "8Bit",
        "parity": "None",
        "stop_bits": "1Bit"
      }
    },
    {
      "type": "Telnet",
      "default": {
        "host": "localhost",
        "port": 23
      }
    },
    {
      "type": "MQTT",
      "default": {
        "host": "",
        "port": "",
        "rx_topic": "",
        "tx_topic": ""
      }
    },
    {
      "type": "Test",
      "default": {
        "name": "Multi Test",
        "color": "#ff4444",
        "type": "Multi",
        "use_timestamp": true,
        "sample_ms": 50
      }
    },
    {
      "type": "CAN",
      "default": {
        "interface": "virtual",
        "channel": "plotter",
        "bitrate": 500000,
        "value_format": "auto",
        "scale": 1.0,
        "offset": 0.0
      }
    }
  ],
  "qml": {
    "interfaces": [
      "Serial",
      "Telnet",
      "MQTT",
      "CAN",
      "Test"
    ]
  },
  "logging": {
    "enabled": true,
    "console_log": false,
    "name": "plotter.log",
    "level": "INFO"
  },
  "performance": {
    "frame_interval_ms": 33,
    "display_points_per_signal": 10000,
    "downsample_enabled": false,
    "downsample_target_hz": 1000
  }
}

{
  "cli": {
    "description": "Multi-Agent Orchestrator für Codex CLI (Architect/Implementer/Tester/Reviewer/Integrator)."
  },
  "final_role_id": "integrator",
  "diff_safety": {
    "allowlist": [
      "agent_families/developer_main.json",
      "agent_families/designer_main.json",
      "agent_families/developer_agents/*",
      "agent_families/designer_agents/*"
    ]
  },
  "requirements_analyst": {
    "enabled": true,
    "auto_enable_threshold_chars": 500,
    "cli_provider": "codex",
    "model": "GPT-5.2-Codex",
    "timeout_sec": 240,
    "max_retries": 2,
    "save_output": true,
    "output_path": "{run_dir}/requirements_analysis.md",
    "analysis": {
      "include_assumptions": true,
      "include_scope_definition": true,
      "include_open_questions": true,
      "include_risks": true,
      "max_assumptions": 10
    },
    "planning": {
      "include_goals": true,
      "include_acceptance_criteria": true,
      "include_allowed_paths": true,
      "include_dependencies": true,
      "include_sharding_hints": true,
      "max_chapters": 6
    },
    "review_mode": {
      "pause_for_review": true,
      "require_confirmation": true,
      "allow_editing": true
    }
  },
  "roles": [
    {
      "id": "architect",
      "file": "../agents/architect.json",
      "instances": 1,
      "depends_on": [],
      "timeout_sec": 1800,
      "max_prompt_chars": 16000,
      "expected_sections": [
        "# Architektur",
        "- Ziele:",
        "- Komponenten:",
        "- Datenmodell:",
        "- API/Interfaces:",
        "- Risiken:",
        "- Plan"
      ],
      "cli_provider": "codex",
      "model": "GPT-5.2-Codex"
    },
    {
      "id": "implementer",
      "file": "../agents/implementer.json",
      "apply_diff": true,
      "instances": 1,
      "depends_on": [
        "architect"
      ],
      "expected_sections": [
        "# Implementierung",
        "- Dateien neu/ändern (Liste):",
        "- Entscheidungen:",
        "- Offene Punkte:",
        "```diff"
      ],
      "cli_provider": "codex",
      "model": "GPT-5.2-Codex"
    },
    {
      "id": "tester",
      "file": "../agents/tester.json",
      "apply_diff": true,
      "instances": 1,
      "depends_on": [
        "implementer"
      ],
      "timeout_sec": 900,
      "expected_sections": [
        "# Tests",
        "- Teststrategie:",
        "- Testfälle:",
        "```diff"
      ],
      "cli_provider": "codex",
      "model": "GPT-5.2-Codex"
    },
    {
      "id": "reviewer",
      "file": "../agents/reviewer.json",
      "apply_diff": true,
      "instances": 1,
      "depends_on": [
        "tester"
      ],
      "timeout_sec": 900,
      "expected_sections": [
        "# Review",
        "- Findings:",
        "- Risiko/Impact:",
        "- Empfohlene Änderungen:",
        "```diff"
      ],
      "cli_provider": "codex",
      "model": "GPT-5.2-Codex"
    },
    {
      "id": "implementer_revision",
      "file": "../agents/implementer_revision.json",
      "apply_diff": true,
      "instances": 1,
      "depends_on": [
        "reviewer"
      ],
      "run_if_review_critical": true,
      "expected_sections": [
        "# Implementierung (Revision)",
        "- Dateien neu/ändern (Liste):",
        "- Entscheidungen:",
        "- Offene Punkte:",
        "```diff"
      ],
      "cli_provider": "codex",
      "model": "GPT-5.2-Codex"
    },
    {
      "id": "integrator",
      "file": "../agents/integrator.json",
      "instances": 1,
      "depends_on": [
        "architect",
        "implementer",
        "tester",
        "reviewer",
        "implementer_revision"
      ],
      "expected_sections": [
        "# Final",
        "- Zusammenfassung:",
        "- Nächste Schritte:"
      ],
      "cli_provider": "codex",
      "model": "GPT-5.2-Codex"
    }
  ]
}